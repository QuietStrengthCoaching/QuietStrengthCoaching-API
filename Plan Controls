import type { Request, Response, NextFunction } from "express";
import { planService } from "../services/plan.service.js";

export async function createActionPlan(req: Request, res: Response, next: NextFunction) {
  try {
    const plan = await planService.create(req.body);
    return res.status(201).json(plan);
  } catch (error) {
    next(error);
  }
}

export async function getActionPlan(req: Request, res: Response, next: NextFunction) {
  try {
    const plan = await planService.getById(req.params.plan_id);
    return res.json(plan);
  } catch (error) {
    next(error);
  }
}

export async function updateActionPlan(req: Request, res: Response, next: NextFunction) {
  try {
    const plan = await planService.update(req.params.plan_id, req.body);
    return res.json(plan);
  } catch (error) {
    next(error);
  }
}
