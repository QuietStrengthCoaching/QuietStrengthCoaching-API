import type { Request, Response, NextFunction } from "express";
import { assessmentService } from "../services/assessment.service.js";

export async function createCulturalIdentityAssessment(req: Request, res: Response, next: NextFunction) {
  try {
    const result = await assessmentService.run("cultural_identity", req.body);
    return res.status(201).json(result);
  } catch (error) {
    next(error);
  }
}

