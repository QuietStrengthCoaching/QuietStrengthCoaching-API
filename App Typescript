import express from "express";
import cors from "cors";
import helmet from "helmet";

import { sessionsRouter } from "./routes/sessions.routes.js";
import { transcriptsRouter } from "./routes/transcripts.routes.js";
import { assessmentsRouter } from "./routes/assessments.routes.js";
import { promptsRouter } from "./routes/prompts.routes.js";
import { plansRouter } from "./routes/plans.routes.js";
import { summariesRouter } from "./routes/summaries.routes.js";
import { reviewsRouter } from "./routes/reviews.routes.js";
import { eventsRouter } from "./routes/events.routes.js";
import { chatsRouter } from "./routes/chats.routes.js";

import { errorMiddleware } from "./middleware/error.middleware.js";
import { authMiddleware } from "./middleware/auth.middleware.js";

export const app = express();

// Security middleware
app.use(cors());
app.use(helmet());
app.use(express.json({ limit: "25mb" }));

// Health check (no auth)
app.get("/health", (_req, res) => {
  res.json({ ok: true, service: "quietstrength-api", timestamp: new Date().toISOString() });
});

// Auth middleware for all routes except health
app.use((req, res, next) => {
  if (req.path === "/health") return next();
  authMiddleware(req, res, next);
});

// Routes
app.use("/v1/sessions", sessionsRouter);
app.use("/v1/transcripts", transcriptsRouter);
app.use("/v1/assessments", assessmentsRouter);
app.use("/v1/intentional-action", promptsRouter);
app.use("/v1/plans", plansRouter);
app.use("/v1/summaries", summariesRouter);
app.use("/v1/reviews", reviewsRouter);
app.use("/v1/events", eventsRouter);
app.use("/v1/chats", chatsRouter);

// Error handling
app.use(errorMiddleware);
