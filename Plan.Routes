import { Router } from "express";
import {
  createActionPlan,
  getActionPlan,
  updateActionPlan
} from "../controllers/plans.controller.js";

export const plansRouter = Router();

plansRouter.post("/action", createActionPlan);
plansRouter.get("/:plan_id", getActionPlan);
plansRouter.patch("/:plan_id", updateActionPlan);
